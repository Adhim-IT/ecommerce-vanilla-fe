{
  "name": "ecommerce-fe",
  "version": "1.0.0",
  "description": "Modern e-commerce frontend application with Tailwind CSS",
  "main": "index.js",
  "scripts": {
    "build": "tailwindcss -i ./assets/src/input.css -o ./assets/dist/output.css",
    "serve": "live-server --port=3000 --no-browser --entry-file=index.html",
    "dev": "concurrently \"npm run build -- --watch\" \"npm run serve\""
  },
  "keywords": [
    "ecommerce",
    "tailwind",
    "frontend"
  ],
  "author": "Developer",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "live-server": "^1.2.2",
    "tailwindcss": "^3.4.1"
  }
}
